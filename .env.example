# Local use only: copy to .env and fill in. NEVER commit .env to GitHub.
# On Render you set these in the dashboard (Environment tab), not in a file.
# dev = local; demo = hosted test system; prod = real money (needs real providers)
ESOKO_ENV=dev
# local SQLite file (used only when DATABASE_URL is empty)
ESOKO_DB_PATH=esoko.db
# Neon pooled connection string, postgresql://...  (required on Render)
DATABASE_URL=
ESOKO_JWT_SECRET=change-me-in-production
ESOKO_ID_PEPPER=change-me-in-production
ESOKO_WEBHOOK_SECRET=change-me-in-production
# lets GitHub Actions call /internal/jobs/*
ESOKO_JOB_SECRET=
ESOKO_USSD_SECRET=
# 
ESOKO_SHORTCODE=*801
ESOKO_SUPPORT_PHONE=+2507XXXXXXXX
ESOKO_SETTLEMENT_MSISDN=+2507XXXXXXXX
ESOKO_SMS_PROVIDER=console
ESOKO_PAYMENT_PROVIDER=mock
# First SuperAdmin, created automatically on first start when no SuperAdmin exists. Delete the password afterwards.
ESOKO_BOOTSTRAP_NAME=Owner
ESOKO_BOOTSTRAP_PHONE=
ESOKO_BOOTSTRAP_PASSWORD=
# Africa's Talking (only when ESOKO_SMS_PROVIDER=africastalking)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=1
